+NSString *const CWErrorDeviceLocked = @"E_DEVICE_LOCKED";
+NSString *const CWErrorSessionLost = @"E_SESSION_LOST";
+NSString *const CWErrorTimeout = @"E_TIMEOUT";
+NSString *const CWErrorBusy = @"E_BUSY";
+NSString *const CWErrorCancelled = @"E_CANCELLED";
+NSString *const CWErrorNotFound = @"E_NOT_FOUND";

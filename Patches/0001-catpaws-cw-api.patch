+  NSInteger remaining = [CWActionRunner.shared remainingSteps];
+  return [CWResponse successWithData:@{
+    @"cancelled" : @(cancelled),
+    @"remaining_steps" : @(remaining),
+  } elapsedMs:[CWResponse elapsedMsSince:start]];
+}
